{
  "name": "my-orders",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "lint": "eslint --ext js,jsx,ts,tsx .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "start": "concurrently \"npm:vlink\"",
    "vlink": "vtex link --verbose --clean",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,graphql,gql}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@vtex/danger": "^0.2.9",
    "@vtex/prettier-config": "1.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-vtex": "15.1.0",
    "eslint-config-vtex-react": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "^3.9.5",
    "typescript": "^4.9.5"
  },
  "dependencies": {},
  "author": {
    "name": "William Di Biasi Bogik",
    "url": "https://github.com/williamcms/"
  }
}
